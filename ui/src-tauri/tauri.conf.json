{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnipType Manager",
  "version": "1.4.0",
  "identifier": "io.github.rteoo.sniptype.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnipType",
        "width": 1120,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../source/sniptype.ico"]
  }
}
